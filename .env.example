# GALARDO environment (MVP lab). Copy to .env if running via process manager.
# Do NOT put secrets in this file - see Prolog §4 (no secrets in Git/scenario/evidence).

# API bind (localhost only per Technical Design §16)
GALARDO_API_HOST=127.0.0.1
GALARDO_API_PORT=8080

# Lab target origin (must be an authorized target; LAB environment)
GALARDO_TARGET_ORIGIN=http://127.0.0.1:8088

# Dev bearer token - MVP lab only (seeded development users; production requires SSO/MFA, Prolog §6 BLOCKER)
GALARDO_DEV_TOKEN=dev-token

# Data directory (state.json + audit.jsonl + evidence/)
GALARDO_DATA_DIR=./data
